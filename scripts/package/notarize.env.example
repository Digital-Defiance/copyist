# Signing and notarization settings for bundle-mac.sh --sign. Put them in your shell
# profile, or copy this to ~/.config/copyist/notarize.env and `source` it (never commit
# the real file).
#   mkdir -p ~/.config/copyist && cp scripts/package/notarize.env.example ~/.config/copyist/notarize.env
export APPLE_SIGNING_IDENTITY="Developer ID Application: Digital Defiance (J6887N729S)"
export APPLE_TEAM_ID=J6887N729S
# Preferred: an App Store Connect API key (used whenever these are set).
export APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export APPLE_API_KEY="XXXXXXXXXX"
export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/AuthKey_XXXXXXXXXX.p8"
# Or an Apple ID with an app-specific password (appleid.apple.com → App-Specific Passwords):
# export APPLE_ID="your-apple-id@example.com"
# export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
