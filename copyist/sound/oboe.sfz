// Copyist oboe: VSCO 2 Community Edition oboe, vibrato (CC0, Versilian Studios).
// Written by scripts/instruments/oboe.py; see that file for how each number was measured.
<control>
default_path=Woodwinds/Oboe/Vib/

<global>
ampeg_attack=0.02
ampeg_release=0.22
amp_veltrack=45
loop_crossfade=0.1

<group> lokey=0 hikey=60 pitch_keycenter=58 volume=3.5
<region> lovel=1 hivel=79 offset=0 tune=0 loop_mode=loop_sustain loop_start=15435 loop_end=452025 sample=Oboe_Vib_A#2_v1_Main.wav
<region> lovel=80 hivel=127 offset=0 tune=-10 loop_mode=loop_sustain loop_start=13230 loop_end=352800 sample=Oboe_Vib_A#2_v3_Main.wav

