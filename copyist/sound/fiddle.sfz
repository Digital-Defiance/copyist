// Copyist fiddle: VSCO 2 Community Edition solo violin, arco vib (CC0, Versilian Studios).
// Written by scripts/instruments/fiddle.py; see that file for how each number was measured.
<control>
default_path=Strings/Solo Violin/Arco Vib/

<global>
ampeg_attack=0.02
ampeg_release=0.22
amp_veltrack=50
loop_crossfade=0.1

<group> lokey=0 hikey=56 pitch_keycenter=55 volume=-0.3
<region> lovel=1 hivel=79 offset=5292 tune=0 loop_mode=loop_sustain loop_start=33075 loop_end=599760 sample=LLVln_ArcoVib_G3_p.wav
