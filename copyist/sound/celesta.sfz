// Copyist celesta: Neil Bickford's A Sampled Celesta (CC0), mono whole-tone subset.
// Samples via Digital-Defiance/copyist-celesta; see scripts/instruments/celesta.py.
<control>
default_path=samples/

<global>
ampeg_attack=0.001
ampeg_release=1.2
amp_veltrack=70
volume=2

<region> lokey=54 hikey=61 pitch_keycenter=60 sample=060_C4.wav
<region> lokey=62 hikey=63 pitch_keycenter=62 sample=062_D4.wav
<region> lokey=64 hikey=65 pitch_keycenter=64 sample=064_E4.wav
