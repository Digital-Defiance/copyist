<region> lokey=76 hikey=77 pitch_keycenter=76 sample=076_E5.wav
<region> lokey=78 hikey=79 pitch_keycenter=78 sample=078_Fs5.wav
<region> lokey=80 hikey=81 pitch_keycenter=80 sample=080_Gs5.wav
<region> lokey=82 hikey=83 pitch_keycenter=82 sample=082_As5.wav
