// Copyist concert harp: VSCO 2 Community Edition (CC0, Versilian Studios).
// Written by scripts/instruments/harp.py; see that file for how each number was measured.
<control>
default_path=Strings/Harp/

<global>
ampeg_attack=0.002
ampeg_release=1.8
amp_veltrack=70

<group> lokey=0 hikey=29 pitch_keycenter=28
<region> lovel=1 hivel=127 offset=880 tune=10 sample=KSHarp_E1_f.wav

<group> lokey=30 hikey=33 pitch_keycenter=31
