{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copyist",
  "version": "0.0.1",
  "identifier": "org.digitaldefiance.copyist",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "The song, the score, the sound",
    "copyright": "Digital Defiance",
    "externalBin": [
      "binaries/copyist-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
